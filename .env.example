LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# Optional: multi-paper synthesis is longer than single-paper QA.
COMPARE_MAX_TOKENS=4096

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
CHROMA_DIR=./chroma_data
CHROMA_COLLECTION=scholarqa_papers
TOP_K=6
RRF_K=60
RERANKER_MODEL=
# Optional: set RERANKER_MODEL=BAAI/bge-reranker-base to enable CrossEncoder rerank.
DEBUG_RETRIEVAL=0

UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
HOST=0.0.0.0
PORT=8000
SCHOLARQA_API_URL=http://127.0.0.1:8000
