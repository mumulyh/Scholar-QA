LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# Optional: multi-paper synthesis is longer than single-paper QA.
COMPARE_MAX_TOKENS=4096

EMBEDDING_MODEL=BAAI/bge-m3
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
CHROMA_DIR=./chroma_data
CHROMA_COLLECTION=scholarqa_papers_bge_m3
TOP_K=6
RRF_K=60
RERANKER_MODEL=
# Optional: set RERANKER_MODEL=BAAI/bge-reranker-base to enable CrossEncoder rerank.
DEBUG_RETRIEVAL=0

# Optional: evaluator LLM for RAGAS. Falls back to LLM_* when these are empty.
EVAL_LLM_BASE_URL=
EVAL_LLM_API_KEY=
EVAL_LLM_MODEL=
EVAL_LLM_TEMPERATURE=0
EVAL_EMBEDDING_MODEL=BAAI/bge-m3

UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
HOST=0.0.0.0
PORT=8000
SCHOLARQA_API_URL=http://127.0.0.1:8000
